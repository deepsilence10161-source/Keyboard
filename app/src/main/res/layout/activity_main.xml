<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AstraKey ⌨️"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/key_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Advance • Smart • Attractive • Easy"
            android:textSize="14sp"
            android:textColor="@color/strip_text" />

        <TextView
            android:id="@+id/statusEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_not_enabled"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_not_selected"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/enable_ime" />

        <Button
            android:id="@+id/btnChoose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/choose_ime" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="सेटिंग्स — कीबोर्ड अगली बार खुलने पर लागू"
            android:textSize="13sp"
            android:textColor="@color/strip_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="डार्क थीम (SwiftKey जैसी)"
                android:textSize="15sp"
                android:textColor="@color/key_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchArrows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="तीर-पंक्ति (कर्सर नियंत्रण)"
                android:textSize="15sp"
                android:textColor="@color/key_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHaptic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="हैप्टिक वाइब्रेशन"
                android:textSize="15sp"
                android:textColor="@color/key_text" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/demo_hint"
            android:textSize="15sp"
            android:textColor="@color/strip_text" />

        <EditText
            android:id="@+id/demoEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textCapSentences"
            android:hint="@string/demo_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="फीचर्स: Samsung-स्टाइल Ctrl कमांड (A/C/V/X सेलेक्ट-कॉपी-पेस्ट-कट), क्लिपबोर्ड, नंबर-रो, हिंदी + हिंग्लिश, इमोजी पैनल, हैप्टिक फीडबैक"
            android:textSize="13sp"
            android:textColor="@color/strip_text" />
    </LinearLayout>
</ScrollView>
