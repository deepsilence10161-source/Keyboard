<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AstraKey ⌨️"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/key_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Advance • Smart • Attractive • Easy"
            android:textSize="14sp"
            android:textColor="@color/strip_text" />

        <TextView
            android:id="@+id/statusEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_not_enabled"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_not_selected"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/enable_ime" />

        <Button
            android:id="@+id/btnChoose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/choose_ime" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="सेटिंग्स — कीबोर्ड अगली बार खुलने पर लागू"
            android:textSize="13sp"
            android:textColor="@color/strip_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="थीम चुनें:"
            android:textSize="14sp"
            android:textColor="@color/key_text" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="डार्क"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="लाइट"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioAmoled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="एमोलेड"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioOcean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ओशन"
                android:textSize="14sp" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/themeGroup2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioSunset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="सूर्यास्त"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioForest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="वन"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioLavender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="लैवेंडर"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioRose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="गुलाब"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="स्थिति-मोड:"
            android:textSize="14sp"
            android:textColor="@color/key_text" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioModeFull"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="पूर्ण"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioModeFloat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="फ्लोटिंग"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioModeLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="एक-हाथ-बाएँ"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioModeRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="एक-हाथ-दाएँ"
                android:textSize="14sp" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchArrows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="तीर-पंक्ति (कर्सर नियंत्रण)"
                android:textSize="15sp"
                android:textColor="@color/key_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHaptic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="हैप्टिक वाइब्रेशन"
                android:textSize="15sp"
                android:textColor="@color/key_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGesture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="जेस्चर-टाइपिंग (स्वाइप से शब्द)"
                android:textSize="15sp"
                android:textColor="@color/key_text" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/demo_hint"
            android:textSize="15sp"
            android:textColor="@color/strip_text" />

        <EditText
            android:id="@+id/demoEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textCapSentences"
            android:hint="@string/demo_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="फीचर्स: Samsung-स्टाइल Ctrl कमांड (A/C/V/X सेलेक्ट-कॉपी-पेस्ट-कट), क्लिपबोर्ड, नंबर-रो, हिंदी + हिंग्लिश, इमोजी पैनल, हैप्टिक फीडबैक"
            android:textSize="13sp"
            android:textColor="@color/strip_text" />
    </LinearLayout>
</ScrollView>
